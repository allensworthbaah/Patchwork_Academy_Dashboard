# Copy this file to .env and adjust if your local Postgres needs a specific user/password.
# The default below works with a fresh Homebrew Postgres install on macOS (no auth required
# for local connections). If your Postgres has a "postgres" role with a password instead, use:
#   DATABASE_URL=postgresql://postgres:<password>@localhost:5432/allensworth_academy
DATABASE_URL=postgresql://localhost:5432/allensworth_academy

PORT=4000
WEB_ORIGIN=http://localhost:5173
