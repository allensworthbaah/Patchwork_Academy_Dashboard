{
  "name": "allensworthos-academy-portal",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "setup:db": "bash scripts/setup-db.sh",
    "dev": "concurrently -k -n api,web -c blue,green \"npm run start -w server\" \"npm run dev -w web\"",
    "dev:server": "npm run start -w server",
    "dev:web": "npm run dev -w web"
  },
  "devDependencies": {
    "concurrently": "8.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
